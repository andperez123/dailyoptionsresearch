OPENAI_API_KEY=sk-your-openai-key-here
FINNHUB_API_KEY=your-finnhub-key-here
FRED_API_KEY=your-fred-api-key-here
ODDS_API_KEY=your-odds-api-key-here

# Optional overrides
# API_SECRET=your-local-secret
# VITE_API_SECRET=your-local-secret
# SEC_USER_AGENT=DegenResearchBot/1.0 (you@example.com)
# DATABASE_PATH=./data/briefings.db          # Railway: /data/briefings.db (mount volume at /data)
# ALLOWED_ORIGINS=https://your-domain.com    # extra CORS origins (comma-separated)
# OPENAI_MODEL_MINI=gpt-5.6-luna
# OPENAI_MODEL=gpt-5.6                # alias routes to gpt-5.6-sol
# OPENAI_REASONING_EFFORT=medium
# OPENAI_USE_WEB_SEARCH=true
# OPENAI_WEB_SEARCH_CONTEXT=medium
# OPENAI_MAX_TOOL_CALLS=12

# Options strategy engine
# OPTIONS_MIN_FRONT_DTE=5             # skip 0-2 DTE theta traps for spreads
# OPTIONS_MIN_BACK_DTE=25             # calendars/diagonals long leg target
# OPTIONS_MIN_LEG_OPEN_INTEREST=50    # liquidity floor per proposed leg
# OPTIONS_MAX_LEG_SPREAD_PCT=15.0     # max bid-ask spread as % of mid
# BUZZ_BASELINE_DAYS=7                # trailing window for buzz z-scores
# NEWS_SCAN_INTERVAL_MINUTES=15
# NEWS_MAX_AGE_HOURS=48
# MARKET_SCAN_INTERVAL_MINUTES=10
# DEEP_DIVE_CACHE_MINUTES=15
# DAILY_BRIEFING_HOUR=8
# MINIMUM_WIRE_IMPACT_SCORE=5
# MINIMUM_WIRE_CONFIDENCE_SCORE=5
# ODDS_DYNAMIC_DISCOVERY=true
# ODDS_MAX_SPORTS_PER_SCAN=8
# ODDS_MAX_EVENTS=24
# SPORTS_SCAN_INTERVAL_MINUTES=60

# Sports bet decision engine
# SPORTS_BET_HORIZON_DAYS=3          # only analyze games starting within N days
# SPORTS_MIN_EDGE_PCT=1.5            # min probability edge (pts) to call a bet
# SPORTS_MIN_EV_PCT=2.0              # min expected value per unit to call a bet
# SPORTS_MIN_BOOKS_FOR_DECISION=3    # min bookmakers quoting the outcome
# SPORTS_KELLY_MULTIPLIER=0.25       # fraction of full Kelly for stake sizing
# SPORTS_MAX_STAKE_UNITS=3.0         # hard cap on stake units per bet
# SPORTS_REQUIRE_EDGE_PERSISTENCE=true  # demote first-sighting bets to lean
# SPORTS_PERSISTENCE_MIN_MINUTES=15  # min age of prior sighting to promote
# SPORTS_TOP_SETUPS_COUNT=5          # ranked setups (bets + best leans) on the board
# ODDS_MAX_BOOKMAKERS_DECISION=10    # book depth fed to the decision engine

# Narrative gating
# DEMOTE_SINGLE_SOURCE_NARRATIVES=true  # keep below-bar theses as labeled low confidence
